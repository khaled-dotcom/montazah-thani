{
  "name": "montazah-thani",
  "version": "0.1.0",
  "private": true,
  "description": "الموقع الرسمي لحي المنتزه الثانية - الإسكندرية | Official website of El Montazah II District, Alexandria",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "preflight": "node scripts/preflight.mjs",
    "build:prod": "npm run preflight:build && next build",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hook-register.mjs --test \"lib/**/*.test.ts\"",
    "test:watch": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hook-register.mjs --test --watch \"lib/**/*.test.ts\"",
    "preflight:build": "node scripts/preflight.mjs --scope=build",
    "preflight:runtime": "node scripts/preflight.mjs --scope=runtime"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
