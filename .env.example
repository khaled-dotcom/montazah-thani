# ---------------------------------------------------------------------------
# حي المنتزه الثانية — copy to .env and fill in. This file itself never holds a
# secret. `npm run preflight` refuses a production build while the placeholders
# remain, and the containers refuse to start.
#
#   cp .env.example .env
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# ── the site ────────────────────────────────────────────────────────────────

# Public site URL, used for metadata / sitemap / social cards, and baked into
# the image at build time — change it and you must rebuild, not just restart.
# Must be the https:// address the public actually types once TLS is on.
NEXT_PUBLIC_SITE_URL=https://montazah2.alexandria.gov.eg

# Staff dashboard at /admin (HTTP Basic). Unset = dashboard returns 503.
# The password is sent on every request, so this is only ever safe behind TLS.
# At least 16 characters: it is one shared account with no lockout, and length
# is its only defence.
ADMIN_USER=
ADMIN_PASSWORD=

# ── nginx and TLS ───────────────────────────────────────────────────────────

# Which config nginx loads from docker/nginx/.
#   http-only.conf  bootstrap, and while certbot gets the first certificate
#   https.conf      production — switch to this and restart nginx
# Do not leave the public site on http-only.conf: /admin sends its password in
# a header that anyone on the network path can read.
NGINX_CONF=http-only.conf

# Host ports nginx publishes. 80/443 unless something else already has them.
HTTP_PORT=80
HTTPS_PORT=443

# ── the database ────────────────────────────────────────────────────────────
# One PostgreSQL server holds two databases that must stay separate: the
# assistant already has an `appointments` table of its own, and a site sharing
# its database would silently read and write the assistant's bookings.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# The assistant's database.
POSTGRES_DB=districts_db
# The website's own database. Created on the first start of an empty pgdata
# volume by docker/postgres-init/. On an existing volume, create it by hand:
#   docker compose exec db psql -U postgres -c 'CREATE DATABASE montazah_site'
SITE_POSTGRES_DB=montazah_site

# Only needed to run the site OUTSIDE compose (npm run dev against a local
# Postgres). Compose builds this for the web container itself, from the values
# above, and ignores whatever is set here.
#   DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/montazah_site
DATABASE_URL=

# A THROWAWAY database for `npm test`. The store tests TRUNCATE their tables
# before running, so this must never point at anything real. Leave it unset and
# those tests skip; the rest of the suite still runs.
TEST_DATABASE_URL=

# ── the citizen-service assistant (agent/) ──────────────────────────────────
# Under docker compose AGENT_URL is set for you (http://agent:4500), which
# keeps the assistant off the public network. Set it here only when running the
# two separately.
#
# With the assistant reachable, the chat panel files complaints, routes them to
# a department, books appointments and issues reference numbers. Without it the
# panel falls back to answering from this site's own content, which it can
# always do.
AGENT_URL=

# Shared secret for the site → assistant hop. Required whenever the assistant
# is NOT on a private network: a cloud ingress is public, and `/api/chat` files
# complaints in residents' names, so anyone who finds the URL can use it.
# ALLOWED_ORIGINS below does not stop that — CORS constrains browsers, and a
# `curl` ignores it entirely.
#
# Set the SAME value here and on the assistant, and it refuses /api/chat and
# appointment cards without it. Under docker compose, where the assistant is
# unreachable from outside, leave it empty.
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENT_TOKEN=

# The assistant's `districts` row this site speaks for. With it set, the
# assistant knows where a caller is writing from and stops asking. Find it
# after the first import:  docker compose exec agent flask import-site-knowledge
AGENT_DISTRICT_ID=

# Required by the assistant — see agent/.env.example for the full list.
SECRET_KEY=
GROQ_API_KEY=

# Origins allowed to embed the assistant's own chat bubble. The site talks to
# it server-to-server, so this only matters if you also embed embed.js.
ALLOWED_ORIGINS=

# 0 only for local development over http.
SECURE_COOKIES=1

# ── fallback assistant ──────────────────────────────────────────────────────
# Used when AGENT_URL is unset or the assistant is unreachable: answers from
# this site's own pages with Claude. Without it the fallback still works, it
# just returns the retrieved passages rather than a written answer.
ANTHROPIC_API_KEY=

# ── builds ──────────────────────────────────────────────────────────────────
# Set to 1 to build a staging image while the content placeholders are still in
# place. Leave unset for production — that is what the preflight is for.
PREFLIGHT_ALLOW_PLACEHOLDERS=
