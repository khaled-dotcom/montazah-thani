# ══════════════════════════════════════════════════════════════════════════
#  انسخ الملف ده لـ .env واملأ القيم. الملف ده نفسه ما يتحطش فيه أسرار.
# ══════════════════════════════════════════════════════════════════════════

# ── إجباري ───────────────────────────────────────────────────────────────
# مفتاح توقيع الجلسات — ولّد واحد عشوائي طويل، وما تشاركهوش:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# قاعدة البيانات (PostgreSQL مع امتداد pgvector)
SQLALCHEMY_DATABASE_URI=postgresql://postgres:CHANGE_ME@db:5432/districts_db

# مفتاح Groq — منه بيشتغل الفهم والرد
GROQ_API_KEY=

# ── الموديل (اختياري) ────────────────────────────────────────────────────
# الافتراضي openai/gpt-oss-120b. البدائل لازم تكون موديلات موجودة فعلاً على
# حسابك — Groq بيوقّف موديلات من وقت للتاني، والبديل اللي بيرجّع 404 بيضيّع
# دورة كاملة والمواطن مستني. اتأكد بـ: flask check-models
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_RETRIES=3
# GROQ_TIMEOUT=45

# ── الـ embeddings (اختياري) ─────────────────────────────────────────────
# Groq مالوش embeddings، فالبحث الدلالي بيشتغل بموديل محلي — مفيش مفتاح
# ولا تكلفة. الافتراضي 384 بُعد و~220MB.
# للجودة الأعلى (1024 بُعد، ~2.2GB): intfloat/multilingual-e5-large
# أي تغيير هنا بيعيد بناء جدول المتجهات، فلازم تعتمد المعرفة تاني.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=/app/.embedding_cache

# ── إعدادات دوكر ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=districts_db

# ── الهوية ───────────────────────────────────────────────────────────────
ORG_NAME=أحياء محافظة الإسكندرية
ORG_SHORT=خدمة المواطن
# الاسم بالإنجليزي — بيتقال في الردود اللي بتطلع بالإنجليزي.
# سيبه فاضي ويرجع للافتراضي العام.
ORG_NAME_EN=

# ── السر المشترك مع الموقع ───────────────────────────────────────────────
# لازم يتظبط لو الخدمة دي على استضافة عامة (Hugging Face Spaces مثلًا).
# ساعتها /api/chat وبطاقات المواعيد بيطلبوا "Authorization: Bearer <token>"،
# ولازم نفس القيمة تتظبط على الموقع (AGENT_TOKEN في .env بتاعه).
#
# ALLOWED_ORIGINS تحت مش بديل: هي بتقيّد المتصفحات، وأي curl بيعدّي منها.
# سيبه فاضي ورا شبكة خاصة بس — في compose الخدمة أصلًا مش مكشوفة.
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENT_TOKEN=

# ── أمان الـ widget ──────────────────────────────────────────────────────
# المواقع المسموح لها تركّب الشات، مفصولة بفاصلة.
# "*" بتسمح لأي موقع — غيّرها قبل التشغيل الحقيقي.
ALLOWED_ORIGINS=*

# أقصى عدد رسائل في الدقيقة لكل جلسة ولكل IP
CHAT_RATE_LIMIT=12

# ── مواعيد الشباك (اختياري) ──────────────────────────────────────────────
# الخانات اللي فورم الحجز بيعرضها. الافتراضي هو نفس سياسة الموقع في
# content/appointments.ts — الأحد للخميس، ٩ ص لـ ١:٣٠، كل نص ساعة، والحجز
# مفتوح من بكرة لـ ٢١ يوم. غيّرها هنا لو الحي بيشتغل بمواعيد تانية.
#
# الجمعة والسبت مقفولين في الكود — إجازة رسمية مش إعداد.
BOOKING_START=09:00
BOOKING_END=13:30
BOOKING_STEP_MINUTES=30

# الحجز بيفتح بعد كام يوم من النهاردة، وبيمتد لكام يوم قدام
BOOKING_LEAD_DAYS=1
BOOKING_HORIZON_DAYS=21

# ── تنبيهات الأعطال بالإيميل (اختياري) ───────────────────────────────────
SMTP_SERVER=
SMTP_PORT=465
NOTIFICATION_EMAIL_SENDER=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_RECEIVERS=
SERVER_IDENTIFIER=alx-districts-agent

# ── تطوير محلي ───────────────────────────────────────────────────────────
# FLASK_DEBUG=1
# PORT=4500
